#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick_tap_ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <150>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <800>;
            global-quick-tap;
            quick-tap-ms = <400>;
            flavor = "balanced";
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 5>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };

        comillas {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <16 17>;
        };

        ComillasSimples {
            bindings = <&kp SQT>;
            key-positions = <28 29>;
        };

        new {
            bindings = <&kp SLASH>;
            key-positions = <29 30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        INITIAL {
            bindings = <
&kp ESC       &kp Q  &kp W  &kp E     &kp R  &kp T      &kp Y         &kp U      &kp I             &kp O     &kp P     &kp BSPC
&hm CAPS TAB  &kp A  &kp S  &kp D     &kp F  &kp G      &kp H         &kp J      &kp K             &kp L     &kp UP    &ltq 2 KP_ENTER
&kp LSHFT     &kp Z  &kp X  &kp C     &kp V  &ltq 5 B   &kp N         &kp M      &kp COMMA         &kp LEFT  &kp DOWN  &kp RIGHT
                            &kp LALT  &to 1  &kp LCTRL  &ltq 1 SPACE  &lt 2 ESC  &ltq 3 BACKSPACE
            >;
        };

        lower_layer {
            bindings = <
&kp ESCAPE      &kp N1           &kp N2       &kp N3        &kp N4       &kp N5                &kp N6              &kp N7     &kp N8         &kp N9                                  &kp N0          &kp BSPC
&kp TAB         &kp EXCLAMATION  &kp AT_SIGN  &kp HASH      &kp DOLLAR   &hm HOME RG(PERCENT)  &hm HOME CARET      &kp AMPS   &kp ASTERISK   &hm LEFT_PARENTHESIS RIGHT_PARENTHESIS  &kp UP_ARROW    &kp KP_ENTER
&kp LEFT_SHIFT  &mo 4            &mo 5        &trans        &kp KP_PLUS  &hm MINUS PLUS        &hm ASTERISK EQUAL  &kp EQUAL  &kp COMMA      &kp LEFT_ARROW                          &kp DOWN_ARROW  &kp RIGHT_ARROW
                                              &kp LEFT_ALT  &to 0        &kp LCTRL             &kp SPACE           &to 0      &kp RIGHT_ALT
            >;
        };

        raise_layer {
            bindings = <
&kp HOME        &kp ESC         &kp UP_ARROW     &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp HOME  &kp HOME  &trans    &kp UP    &trans     &kp K_MUTE         &hm C_VOL_UP C_VOL_DN
&mo 4           &kp LEFT_ARROW  &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp KP_NUMBER_6  &kp AT    &mo 5     &kp LEFT  &kp DOWN  &kp RIGHT  &kp C_VOLUME_UP    &mo 4
&kp LEFT_SHIFT  &kp DELETE      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp END   &kp END   &trans    &trans    &trans     &kp C_VOLUME_DOWN  &kp RIGHT_SHIFT
                                                 &kp LEFT_ALT     &kp LEFT_WIN     &trans    &trans    &trans    &mo 5
            >;
        };

        layer_3 {
            bindings = <
&kp ESC         &kp F1      &kp F2           &kp F3           &kp F4           &kp F5   &kp F6   &kp F7    &kp F8     &kp F9      &kp F10           &kp DEL
&kp CAPSLOCK    &trans      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp F11  &kp F12  &kp LEFT  &kp DOWN   &kp RIGHT   &kp LEFT_BRACKET  &hm RBKT SEMI
&kp LEFT_SHIFT  &kp DELETE  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DOT  &trans   &trans    &kp COMMA  &kp PERIOD  &kp SLASH         &kp RIGHT_SHIFT
                                             &kp LCTRL        &kp LEFT_ALT     &trans   &trans   &trans    &trans
            >;
        };

        RGB {
            bindings = <
&trans  &bl BL_SET 100  &bl BL_CYCLE  &rgb_ug RGB_EFF                  &bl BL_TOG  &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(43,1,33)   &rgb_ug RGB_COLOR_HSB(183,100,59)  &rgb_ug RGB_COLOR_HSB(30,93,48)
&trans  &bl BL_SET 50   &trans        &rgb_ug RGB_COLOR_HSB(0,100,24)  &bl BL_INC  &rgb_ug RGB_BRI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_TOG  &bl BL_TOG                       &rgb_ug RGB_COLOR_HSB(239,72,46)   &trans
&trans  &bl BL_SET 10   &trans        &rgb_ug RGB_EFR                  &bl BL_DEC  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF  &bl BL_INC       &rgb_ug RGB_SPD  &rgb_ug RGB_COLOR_HSB(0,100,50)  &rgb_ug RGB_COLOR_HSB(63,100,77)   &rgb_ug RGB_COLOR_HSB(0,0,100)
                                      &trans                           &trans      &trans           &trans           &trans           &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &trans  &bt BT_CLR      &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_COLOR_HSB(298,100,50)  &rgb_ug RGB_COLOR_HSB(43,1,33)   &rgb_ug RGB_SPI  &rgb_ug RGB_COLOR_HSB(30,93,48)
&trans  &bt BT_NXT     &trans         &trans         &trans  &bt BT_CLR_ALL  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_TOG                    &rgb_ug RGB_COLOR_HSB(0,100,50)  &rgb_ug RGB_SPD  &trans
&trans  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &trans  &trans          &rgb_ug RGB_EFF  &bl BL_INC       &bl BL_TOG                         &rgb_ug RGB_COLOR_HSB(0,0,95)    &trans           &trans
                                      &trans         &trans  &trans          &trans           &trans           &trans
            >;
        };
    };
};
